rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && request.auth.token.admin == true;
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Categories
    // ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      // Public can read active categories; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update categories
      allow create: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.isActive is bool;

      allow update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.slug is string && request.resource.data.slug.size() > 0
        && request.resource.data.isActive is bool;

      // Categories should be deactivated, not hard-deleted
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Products
    // ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public can read active products; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update products
      allow create: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.categoryId is string
        && request.resource.data.price is int && request.resource.data.price >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.isActive is bool;

      allow update: if isAdmin()
        && request.resource.data.name is string && request.resource.data.name.size() > 0
        && request.resource.data.description is string
        && request.resource.data.categoryId is string
        && request.resource.data.price is int && request.resource.data.price >= 0
        && request.resource.data.stock is int && request.resource.data.stock >= 0
        && request.resource.data.isActive is bool;

      // Products should be deactivated, not hard-deleted
      allow delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Users, Carts & Orders (Per FIRESTORE_SCHEMA.md)
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /orders/{orderId} {
      // Read: owner or admin
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // SECURITY: Orders must only be created by a trusted Cloud Function
      // using the Firebase Admin SDK (bypasses these rules).
      // Direct client writes are forbidden to prevent price/stock manipulation.
      allow create: if false;

      // Admin-only status updates (e.g. shipped, delivered, cancelled)
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

