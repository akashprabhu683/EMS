rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Categories
    // ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      // Public can read active categories; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update/delete categories
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Products
    // ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public can read active products; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Users, Carts & Orders (Per FIRESTORE_SCHEMA.md)
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /orders/{orderId} {
      // Read: Customer owner can read their own orders; Admins can read all orders
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // SECURITY LOCKDOWN (PHASE 1):
      // Direct client creation is blocked. All orders MUST be created via the trusted
      // serverless `createOrder` Cloud Function which performs atomic inventory reservation,
      // idempotency checking, trusted price calculation in paise, and cart clearing.
      allow create: if false;

      // Update: Admins can update status; Owner cannot change totals or status arbitrarily
      allow update: if isAdmin() || (
        isAuthenticated() &&
        resource.data.userId == request.auth.uid &&
        // Customer can only cancel their own order if it's still 'placed'
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['orderStatus', 'statusHistory', 'updatedAt']) &&
        request.resource.data.orderStatus == 'cancelled' &&
        resource.data.orderStatus == 'placed'
      );

      // Customer can delete from their personal order history; Admins can delete
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid) || isAdmin();
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Admin Management, Revocations & Invitations
    // ─────────────────────────────────────────────────────────────
    match /admins/{uid} {
      // Admins can read all; authenticated user can read their own admin doc to observe live revocation
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admin_revocations/{uid} {
      // Real-time broadcast signal for revoked administrators
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /admin_invitations/{email} {
      allow read, write: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Append-Only Server Audit Trail & Operational Reports
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Only authenticated dispensary administrators can read audit trails
      allow read: if isAdmin();
      // Immutable append-only: Clients CANNOT create, update or delete audit records
      allow create, update, delete: if false;
    }

    match /operational_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

