rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isSuperadmin() {
      return isAuthenticated() && (
        request.auth.token.email.lower() == 'akashprabhu0302@gmail.com' ||
        request.auth.token.superadmin == true
      );
    }

    function isRevoked() {
      return exists(/databases/$(database)/documents/admin_revocations/$(request.auth.uid));
    }

    function isAdmin() {
      return isAuthenticated() && (
        isSuperadmin() ||
        (!isRevoked() && (
          request.auth.token.admin == true ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        ))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Categories
    // ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      // Public can read active categories; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // SECURITY LOCKDOWN (PHASE 6C):
      // Direct client creation, update, and deletion are strictly denied for all clients.
      // All category mutations MUST route through authoritative Cloud Functions
      // or trusted Express backend APIs via the Firebase Admin SDK.
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Products
    // ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public can read active products; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // SECURITY LOCKDOWN (PHASE 6C):
      // Direct client creation, update, and deletion are strictly denied for all clients.
      // All product mutations, stock adjustments, and deactivations MUST route
      // through authoritative Cloud Functions or trusted Express backend APIs.
      allow create, update, delete: if false;
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Users, Carts & Orders (Per FIRESTORE_SCHEMA.md)
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();

      // Device tokens for mobile FCM push alerts
      match /fcm_tokens/{tokenId} {
        allow read, write: if isOwner(uid) || isAdmin();
      }

      // Customer in-app notification alerts (reliable website fallback)
      match /notifications/{notifId} {
        allow read: if isOwner(uid) || isAdmin();
        allow update: if isOwner(uid) || isAdmin();
        allow create, delete: if isAdmin();
      }
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /orders/{orderId} {
      // Read: Customer owner can read their own orders; Admins can read all orders
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // SECURITY LOCKDOWN (PHASE 6A):
      // Direct client creation, update, and deletion are strictly denied for all clients (customers and admins).
      // All business-critical order operations (creation, lifecycle status transitions, collection PIN verification,
      // cancellation with atomic stock restoration, and payment recording) MUST route
      // through authoritative Cloud Functions or trusted Express backend APIs via the Firebase Admin SDK.
      allow create: if false;
      allow update: if false;
      allow delete: if false;

      // Notifications subcollection (immutable by clients)
      match /notifications/{notifId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid) || isAdmin();
        allow write: if false;
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Admin Management, Revocations & Invitations
    // ─────────────────────────────────────────────────────────────
    match /admins/{uid} {
      // Admins can read all; authenticated user can read their own admin doc to observe live revocation
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isSuperadmin();

      match /fcm_tokens/{tokenId} {
        allow read, write: if isAdmin() && (request.auth.uid == uid || isSuperadmin());
      }
    }

    match /admin_notifications/{notifId} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    match /admin_revocations/{uid} {
      // Real-time broadcast signal for revoked administrators
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isSuperadmin();
    }

    match /admin_invitations/{email} {
      allow read: if isAdmin();
      allow write: if isSuperadmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 5. Append-Only Server Audit Trail & Operational Reports
    // ─────────────────────────────────────────────────────────────
    match /audit_logs/{logId} {
      // Only authenticated dispensary administrators can read audit trails
      allow read: if isAdmin();
      // Immutable append-only: Clients CANNOT create, update or delete audit records
      allow create, update, delete: if false;
    }

    match /operational_reports/{reportId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }

    // Deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

