rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper functions
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.admin == true ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // ─────────────────────────────────────────────────────────────
    // 1. Categories
    // ─────────────────────────────────────────────────────────────
    match /categories/{categoryId} {
      // Public can read active categories; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update/delete categories
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 2. Products
    // ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      // Public can read active products; Admins can read all
      allow read: if (resource.data.isActive == true) || isAdmin();

      // Only admins can create/update/delete products
      allow create, update, delete: if isAdmin();
    }

    // ─────────────────────────────────────────────────────────────
    // 3. Users, Carts & Orders (Per FIRESTORE_SCHEMA.md)
    // ─────────────────────────────────────────────────────────────
    match /users/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /carts/{uid} {
      allow read, write: if isOwner(uid) || isAdmin();
    }

    match /orders/{orderId} {
      // Read: owner or admin
      allow read: if (isAuthenticated() && resource.data.userId == request.auth.uid) || isAdmin();

      // Allow authenticated customer to create their own order
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;

      // Allow admin to advance order status, or owner to update/cancel order
      allow update: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Allow user or admin to delete order from order history
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);

      // Notifications subcollection
      match /notifications/{notifId} {
        allow read: if (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid) || isAdmin();
        allow write: if isAdmin() || (isAuthenticated() && get(/databases/$(database)/documents/orders/$(orderId)).data.userId == request.auth.uid);
      }
    }

    // ─────────────────────────────────────────────────────────────
    // 4. Admin Management, Revocations & Invitations
    // ─────────────────────────────────────────────────────────────
    match /admins/{uid} {
      // Admins can read all; authenticated user can read their own admin doc to observe live revocation
      allow read: if isAdmin() || (isAuthenticated() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    match /admin_revocations/{uid} {
      // Real-time broadcast signal for revoked administrators
      allow read: if isAuthenticated() && request.auth.uid == uid;
      allow write: if isAdmin();
    }

    match /admin_invitations/{email} {
      allow read, write: if isAdmin();
    }

    // Deny any other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

